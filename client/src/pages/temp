// =============================================
// src/pages/Profile.jsx
// =============================================
// This page shows the logged in user's profile
//
// For patients it shows:
// - Basic info
// - Medical notes
// - List of caregivers with access
// - Ability to grant/revoke caregiver access
//
// For caregivers it shows:
// - Basic info
// - List of patients they have access to
// =============================================

import React, { useState, useEffect } from 'react';
import api from '../services/api';

function Profile() {
  // Logged in user from localStorage
  const user = JSON.parse(localStorage.getItem('user'));

  // Stores caregivers (for patients)
  // or patients (for caregivers)
  const [connections, setConnections] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState('');
  const [success, setSuccess] = useState('');

  // For granting access to a new caregiver
  const [caregiverEmail, setCaregiverEmail] = useState('');
  const [showGrantForm, setShowGrantForm] = useState(false);

  useEffect(() => {
    fetchConnections();
  }, []);

  // =============================================
  // fetchConnections
  // =============================================
  // Fetches caregivers if patient
  // Fetches patients if caregiver
  const fetchConnections = async () => {
    try {
      if (user.role === 'patient') {
        const response = await api.get('/access/my-caregivers');
        setConnections(response.data);
      } else {
        const response = await api.get('/access/my-patients');
        setConnections(response.data);
      }
    } catch (err) {
      setError('Failed to load connections');
    } finally {
      setLoading(false);
    }
  };

  // =============================================
  // handleGrantAccess
  // =============================================
  // Patient grants a caregiver access
  // by entering their email address
  const handleGrantAccess = async (e) => {
    e.preventDefault();
    setError('');
    setSuccess('');

    try {
      await api.post('/access/grant', {
        caregiver_email: caregiverEmail
      });

      setSuccess('Access granted successfully!');
      setCaregiverEmail('');
      setShowGrantForm(false);
      fetchConnections();

    } catch (err) {
      setError(err.response?.data?.error || 'Failed to grant access');
    }
  };

  // =============================================
  // handleRevokeAccess
  // =============================================
  // Patient revokes a caregiver's access
  const handleRevokeAccess = async (caregiverId) => {
    setError('');
    setSuccess('');

    try {
      await api.delete(`/access/revoke/${caregiverId}`);
      setSuccess('Access revoked successfully!');
      fetchConnections();

    } catch (err) {
      setError(err.response?.data?.error || 'Failed to revoke access');
    }
  };

  const getStatusColor = (status) => {
    switch (status) {
      case 'approved': return { bg: '#e8f5e9', color: '#2e7d32' };
      case 'pending': return { bg: '#fff8e1', color: '#f57f17' };
      case 'revoked': return { bg: '#ffebee', color: '#c62828' };
      default: return { bg: '#f5f5f5', color: '#666' };
    }
  };

  if (loading) {
    return <div style={styles.loading}>Loading...</div>;
  }

  return (
    <div style={styles.container}>

      {/* Profile header */}
      <div style={styles.profileCard}>
        <div style={styles.avatar}>
          {user.first_name[0]}{user.last_name[0]}
        </div>
        <div style={styles.profileInfo}>
          <h1 style={styles.name}>
            {user.first_name} {user.last_name}
          </h1>
          <p style={styles.email}>{user.email}</p>
          <span style={styles.roleBadge}>{user.role}</span>
        </div>
      </div>

      {/* Success and error messages */}
      {error && <p style={styles.error}>{error}</p>}
      {success && <p style={styles.success}>{success}</p>}

      {/* Caregivers section for patients */}
      {user.role === 'patient' && (
        <div style={styles.section}>
          <div style={styles.sectionHeader}>
            <h2 style={styles.sectionTitle}>My Caregivers</h2>
            <button
              onClick={() => setShowGrantForm(!showGrantForm)}
              style={styles.addButton}
            >
              {showGrantForm ? 'Cancel' : '+ Add Caregiver'}
            </button>
          </div>

          {/* Grant access form */}
          {showGrantForm && (
            <form onSubmit={handleGrantAccess} style={styles.grantForm}>
              <input
                type="email"
                value={caregiverEmail}
                onChange={(e) => setCaregiverEmail(e.target.value)}
                style={styles.input}
                placeholder="Enter caregiver's email address"
                required
              />
              <button type="submit" style={styles.submitButton}>
                Grant Access
              </button>
            </form>
          )}

          {/* List of caregivers */}
          {connections.length === 0 ? (
            <div style={styles.empty}>
              <p>No caregivers yet. Add one above!</p>
            </div>
          ) : (
            <div style={styles.list}>
              {connections.map(caregiver => {
                const statusStyle = getStatusColor(caregiver.status);
                return (
                  <div key={caregiver.id} style={styles.connectionCard}>
                    <div style={styles.connectionInfo}>

                      {/* Caregiver avatar */}
                      <div style={styles.smallAvatar}>
                        {caregiver.first_name[0]}{caregiver.last_name[0]}
                      </div>

                      <div>
                        <p style={styles.connectionName}>
                          {caregiver.first_name} {caregiver.last_name}
                        </p>
                        <p style={styles.connectionEmail}>
                          {caregiver.email}
                        </p>
                        {caregiver.can_drive && (
                          <p style={styles.canDrive}>🚗 Can drive</p>
                        )}
                      </div>
                    </div>

                    <div style={styles.connectionActions}>
                      <span style={{
                        ...styles.statusBadge,
                        backgroundColor: statusStyle.bg,
                        color: statusStyle.color
                      }}>
                        {caregiver.status}
                      </span>

                      {/* Only show revoke for approved caregivers */}
                      {caregiver.status === 'approved' && (
                        <button
                          onClick={() => handleRevokeAccess(caregiver.id)}
                          style={styles.revokeButton}
                        >
                          Revoke
                        </button>
                      )}
                    </div>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      )}

      {/* Patients section for caregivers */}
      {user.role === 'caregiver' && (
        <div style={styles.section}>
          <h2 style={styles.sectionTitle}>My Patients</h2>

          {connections.length === 0 ? (
            <div style={styles.empty}>
              <p>No patients yet. Ask a patient to add you!</p>
            </div>
          ) : (
            <div style={styles.list}>
              {connections.map(patient => {
                const statusStyle = getStatusColor(patient.status);
                return (
                  <div key={patient.id} style={styles.connectionCard}>
                    <div style={styles.connectionInfo}>
                      <div style={styles.smallAvatar}>
                        {patient.first_name[0]}{patient.last_name[0]}
                      </div>
                      <div>
                        <p style={styles.connectionName}>
                          {patient.first_name} {patient.last_name}
                        </p>
                        <p style={styles.connectionEmail}>
                          {patient.email}
                        </p>
                        {patient.address && (
                          <p style={styles.connectionDetail}>
                            📍 {patient.address}
                          </p>
                        )}
                      </div>
                    </div>
                    <span style={{
                      ...styles.statusBadge,
                      backgroundColor: statusStyle.bg,
                      color: statusStyle.color
                    }}>
                      {patient.status}
                    </span>
                  </div>
                );
              })}
            </div>
          )}
        </div>
      )}

    </div>
  );
}

